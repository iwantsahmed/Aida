# --- Android / Gradle ---
*.iml
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/
local.properties
gradle-app.setting
.gradletasknamecache

# Kotlin
.kotlin/

# --- Build outputs ---
*.apk
*.aab
*.ap_
*.dex
*.class
output.json

# --- Signing material. Never commit a keystore or its password. ---
*.jks
*.keystore
keystore.properties
signing.properties

# --- Secrets. Mira has no server, but nothing key-shaped belongs in git. ---
secrets.properties
*.env
.env.*

# --- IntelliJ / Android Studio ---
# Listed as .idea/* rather than .idea/ so a shared code style could be un-ignored later;
# git will not descend into a directory ignored with a trailing slash.
.idea/*
*.ipr
*.iws
/out/

# --- macOS / editors ---
.DS_Store
Thumbs.db
*.swp
*~

# --- Logs, profiling, crash dumps ---
*.log
*.hprof
hs_err_pid*
replay_pid*

# --- Test and lint reports (regenerated by the build).
#     Anchored, so a source directory that happens to share a name is not swallowed. ---
/lint/
/reports/
/test-results/

# NOTE: app/schemas/ is deliberately NOT ignored. Room's exported schema JSON is the
# record of every shipped database version and is what migration tests run against.
