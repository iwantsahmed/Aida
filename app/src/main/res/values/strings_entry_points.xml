    <!--
      The two capture buttons. Their own strings rather than the shortcut labels above: a launcher
      menu row and a button on the home screen are different amounts of space, and sharing one
      string would tie the two together the next time either needs to be shorter.
    -->
    <string name="mira_widget_note">New note</string>
    <string name="mira_widget_ink">Quick Ink</string>

    <!-- The share sheet draws this while Mira is not running, so it is a resource rather
         than a phrasebook string: the system picks the language, not Mira. -->
    <string name="mira_share_label">Ask Aida</string>

    <!-- The cross-app tier. The system draws the label and description on its own accessibility
         and notification-access settings screens, in the device's language, so they are resources. -->
    <string name="mira_accessibility_label">Aida cross-app actions</string>
    <string name="mira_notification_listener_label">Aida notification automations</string>
    <string name="mira_accessibility_description">Lets Aida perform system gestures you ask her to automate — back, home, recents. She presses the button and nothing more: this service cannot read what is on your screen. Off until you turn it on, and Aida works fully without it.</string>
</resources>
