    <string name="mira_shortcut_scan_long">Scan receipt or document</string>
    <string name="mira_shortcut_today_short">Today</string>
    <string name="mira_shortcut_today_long">Today at a glance</string>

    <string name="mira_tile_label">Aida</string>
