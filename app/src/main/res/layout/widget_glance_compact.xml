<?xml version="1.0" encoding="utf-8"?>
<!--
  "Mira — Today" glance, compact cell: the counts headline and the money line only, both bound at
  runtime by WidgetRefreshWorker. The whole cell taps through to Home (ACTION_TODAY). Same palette
  tokens as the full layout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_glance_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mira_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_glance_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="@color/mira_platinum"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_glance_money"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/mira_accent"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
