<?xml version="1.0" encoding="utf-8"?>
<!--
  Obsidian with a hairline, exactly as MiraCard sits on a screen: separated by a line rather than
  by a shadow. The stroke is MiraSpacing.hairline.

  The radius is the launcher's own rather than MiraShapes.large: from Android 12 the system clips
  every widget to system_app_widget_background_radius, and a different radius underneath shows as
  a doubled corner. Matching it is the only way the edge reads as one object.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/mira_obsidian" />
    <stroke
        android:width="1dp"
        android:color="@color/mira_hairline" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
