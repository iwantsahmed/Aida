<?xml version="1.0" encoding="utf-8"?>
<!--
  Mira's accessibility service, declared as a pure actuator.

  canRetrieveWindowContent="false" is the load-bearing line: it means this service can perform
  global gestures (back/home/recents, via performGlobalAction) but has no capability to read window
  content, so Mira presses the button and sees nothing of the screen. The event type is the minimum
  the platform requires for a bound service and nothing is done with the events (onAccessibilityEvent
  is empty). See docs/PRIVACY.md §6.5.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/mira_accessibility_description" />
